{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gator",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-11-01",
  // Required by the OAuth library to fetch Client ID Metadata Documents safely.
  "compatibility_flags": ["global_fetch_strictly_public"],
  // A smaller script is less for a cold isolate to parse.
  "minify": true,
  // Serve at <name>.<account>.workers.dev on every deploy; a Worker made by the
  // Deploy button otherwise starts with it off. No preview URLs: one instance only.
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "apps/dashboard/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/mcp", "/api/*", "/authorize", "/oauth/*", "/.well-known/*"]
  },
  // No IDs: `wrangler deploy` creates a database and a namespace for each Worker name.
  "d1_databases": [{ "binding": "DB" }],
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  "triggers": { "crons": ["17 * * * *"] },
  "secrets": { "required": ["MASTER_KEY", "OWNER_PASSWORD"] },
  "observability": { "enabled": true }
}
